# Copy to .env and fill in. Every variable is validated at startup
# (src/config/env.js); the server refuses to start on invalid values.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# LOG_LEVEL=info

# ── MongoDB (Atlas or a replica set; transactions need a replica set) ─────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# auto | on | off — "auto" detects replica-set support
MONGO_TRANSACTIONS=auto
# Refuse to start while required data migrations are pending (default: true in production)
# REQUIRE_MIGRATIONS=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 random characters in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_STAFF=8h
BCRYPT_ROUNDS=12

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
# Reverse-proxy hops to trust for X-Forwarded-* (1 behind a single load balancer)
TRUST_PROXY=0
# Public base URL of this API, used for file links (recommended in production)
# PUBLIC_API_URL=https://api.example.com
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# ── Web app links ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
# Password reset link target; defaults to FRONTEND_URL/reset-password
# PASSWORD_RESET_URL=https://app.example.com/reset-password

# ── Email (password reset). Without it, dev logs the email; prod sends nothing.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Rental Manager <no-reply@example.com>

# ── File storage ──────────────────────────────────────────────────────────────
# local: files under STORAGE_LOCAL_DIR (must be a persistent volume in production)
# s3:    any S3-compatible bucket (AWS S3, Cloudflare R2, DO Spaces, MinIO)
STORAGE_DRIVER=imagekit
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PRIVATE_KEY=
# Only needed for future client-side direct uploads; never expose the private key.
# IMAGEKIT_PUBLIC_KEY=
STORAGE_LOCAL_DIR=storage
# Folder of files uploaded by older versions (served read-only via signed links)
LEGACY_UPLOADS_DIR=uploads
UPLOAD_MAX_BYTES=10485760
# FILE_SIGNING_SECRET=  (defaults to a value derived from JWT_SECRET)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Optional CDN/public bucket URL for public images (equipment photos, logos)
# S3_PUBLIC_BASE_URL=https://files.example.com

# ── SaaS billing ──────────────────────────────────────────────────────────────
TRIAL_DAYS=14
# Optional Stripe (checkout/portal answer 501 until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
