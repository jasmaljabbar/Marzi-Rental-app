{
  "name": "rental-app-backend",
  "version": "1.0.0",
  "description": "Node.js + MongoDB Atlas backend for the Equipment Rental App",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/runTests.js",
    "test:coverage": "node scripts/runTests.js --coverage",
    "lint": "node scripts/checkSyntax.js",
    "docs:postman": "node scripts/postman/generate.js",
    "seed:demo": "node scripts/postman/seed.js",
    "test:postman": "node scripts/postman/run.js",
    "migrate": "node scripts/migrate.js",
    "seed:plans": "node scripts/seedPlans.js",
    "seed:super-admin": "node scripts/seedSuperAdmin.js",
    "migrate:tenant": "node scripts/migrateToTenant.js",
    "promote:platform-admin": "node scripts/promotePlatformAdmin.js",
